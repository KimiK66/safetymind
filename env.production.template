# SafetyMind Production Environment Configuration
# Copy this file to .env.production and configure for your deployment

# Server Configuration
SAFETYMIND_HOST=0.0.0.0
SAFETYMIND_PORT=8000
SAFETYMIND_WORKERS=4
SAFETYMIND_LOG_LEVEL=INFO
DEBUG=false
RELOAD=false

# Database Configuration
# For SQLite (default)
DATABASE_URL=sqlite:///app/safetymind.db

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://safetymind:your_password@localhost:5432/safetymind

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-domain.com
CORS_CREDENTIALS=true

# API Keys (Required for full functionality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MEM0_API_KEY=your_mem0_api_key_here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# File Upload Limits
MAX_FILE_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300

# Cache Configuration
CACHE_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_FILE_PATH=/app/logs/safetymind.log

# Error Tracking (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Email Configuration (Optional)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your_email@your-domain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@your-domain.com

# PostgreSQL Configuration (if using PostgreSQL)
POSTGRES_PASSWORD=your_postgres_password

# Voice Settings
VOICE_MODEL_ID=eleven_multilingual_v2
VOICE_SPEED=1.0
VOICE_STABILITY=0.5

# Memory Settings
MEMORY_MAX_CONTEXT_SIZE=10000
MEMORY_LEARNING_RATE=0.1

# Groq Settings
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=4000
GROQ_TEMPERATURE=0.7
